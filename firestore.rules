rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // HELPER FUNCTIONS
    // ----------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isAdmin() {
      return hasRole('Admin');
    }
    
    function isTeacher() {
      return hasRole('Teacher') || isAdmin();
    }
    
    function isDriver() {
      return hasRole('Driver') || isAdmin();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      // Anyone logged in can read basic profile info
      allow read: if isAuthenticated();
      // Only Admin or the user themselves during initial registration can create/update
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAuthenticated() && (isAdmin() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // STUDENTS & DIRECTORY
    // ----------------------------------------------------
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // ATTENDANCE
    // ----------------------------------------------------
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ----------------------------------------------------
    // EXAMS & MARKS
    // ----------------------------------------------------
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /exam_marks/{markId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ----------------------------------------------------
    // FEES & TRANSACTIONS
    // ----------------------------------------------------
    match /fees/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // TIMETABLE
    // ----------------------------------------------------
    match /timetable/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ----------------------------------------------------
    // NOTICES & CIRCULARS
    // ----------------------------------------------------
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ----------------------------------------------------
    // NOTIFICATIONS
    // ----------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid || 
        resource.data.targetRole == getUserData().role || 
        resource.data.targetRole == 'all' ||
        isAdmin()
      );
      allow create: if isTeacher();
      allow update: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // FLEET & DRIVER LIVE GPS TRACKING
    // ----------------------------------------------------
    match /fleet/{busId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /driver_locations/{driverId} {
      // Students, Teachers & Parents can view bus locations
      allow read: if isAuthenticated();
      // Only the assigned driver or admin can update location coordinates
      allow write: if isAuthenticated() && (
        request.auth.uid == driverId || 
        isDriver()
      );
    }

    match /fuel_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isDriver();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
